(kicad_pcb
	(version 20260206)
	(generator "kirend-test")
	(generator_version "10.0")
	(general
		(thickness 1.6)
	)
	(layers
		(0 "F.Cu" signal)
		(2 "B.Cu" signal)
		(5 "F.SilkS" user "F.Silkscreen")
		(25 "Edge.Cuts" user)
	)
	(setup
		(stackup
			(layer "F.Cu" (type "copper") (thickness 0.035))
			(layer "dielectric 1" (type "core") (thickness 1.51) (material "FR4"))
			(layer "B.Cu" (type "copper") (thickness 0.035))
		)
	)
	(footprint "Test:R"
		(layer "F.Cu")
		(at 50 40 90)
		(property "Reference" "R1" (at 0 0 0) (layer "F.SilkS"))
		(attr smd)
		(fp_line (start -1 -0.5) (end 1 -0.5) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
		(pad "1" smd roundrect (at -0.8 0 90) (size 0.6 0.7) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.25))
		(pad "2" thru_hole circle (at 0.8 0 90) (size 1.2 1.2) (drill 0.6) (layers "*.Cu" "*.Mask"))
		(model "${KIPRJMOD}/models/part.wrl"
			(offset (xyz 0 0 0.5))
			(scale (xyz 1 1 1))
			(rotate (xyz 0 0 90))
		)
	)
	(gr_line (start 0 0) (end 100 0) (stroke (width 0.1) (type default)) (layer "Edge.Cuts"))
	(gr_line (start 100 0) (end 100 80) (stroke (width 0.1) (type default)) (layer "Edge.Cuts"))
	(gr_arc (start 100 80) (mid 97.071 87.071) (end 90 90) (stroke (width 0.1) (type default)) (layer "Edge.Cuts"))
	(gr_line (start 90 90) (end 0 90) (stroke (width 0.1) (type default)) (layer "Edge.Cuts"))
	(gr_line (start 0 90) (end 0 0) (stroke (width 0.1) (type default)) (layer "Edge.Cuts"))
	(gr_circle (center 20 20) (end 25 20) (stroke (width 0.1) (type default)) (fill no) (layer "Edge.Cuts"))
	(segment (start 10 10) (end 30 10) (width 0.25) (layer "F.Cu") (net "GND"))
	(via (at 30 10) (size 0.6) (drill 0.3) (layers "F.Cu" "B.Cu") (net "GND"))
	(gr_text "label \"quoted\"" (at 50 50 0) (layer "F.SilkS"))
)
